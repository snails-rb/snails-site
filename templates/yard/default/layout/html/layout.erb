<!DOCTYPE html>
<html>
  <head>
    <%= erb(:headers) %>
    <link rel="stylesheet" href="<%= u = url_for(''); u + (u != '' ? '/' : '') %>css/site-chrome.css" type="text/css">
    <!-- The brand favicon set is transparent ink, which disappears on a dark
         browser tab. The site uses the same marks on a rounded paper tile
         instead. -->
    <link rel="icon" href="/favicon.ico" sizes="any">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png">
    <link rel="alternate" type="application/rss+xml" title="Snails Blog" href="https://snails-rb.org/blog/rss.xml">
  </head>
  <body>
    <div id="main_progress" aria-hidden="true"></div>

    <!-- The site header is shared with the Astro pages, so moving between the
         manual and the API reference does not change the top of the page. -->
    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href="/">
          <!-- The site is dark-only, so the header uses the white lockup;
               the ink lockup is for light backgrounds. -->
          <img src="/brand/lockup-horizontal-white.svg" alt="Snails" width="71" height="16">
        </a>
        <nav class="site-nav">
          <a href="<%= ENV.fetch("MANUAL_ENTRY_URL") %>">Manual</a>
          <a href="/blog/">Blog</a>
          <a class="active" href="/api/">API</a>
        </nav>
      </div>
    </header>

    <!-- YARD's own layout puts the navigation and the content side by side and
         fills the viewport. The wrapper gives them the space that is left under
         the header, so nothing is clipped at the bottom. -->
    <div class="yard-body">
      <div class="nav_wrap">
        <iframe id="nav" src="<%= @nav_url %>?1"></iframe>
        <div id="resizer"></div>
      </div>

      <div id="main" tabindex="-1">
        <div id="header">
          <%= erb(:breadcrumb) %>
          <%= erb(:search) %>
          <div class="clear"></div>
        </div>

        <div id="content"><%= yieldall %></div>

        <%= erb(:footer) %>
      </div>
    </div>
  </body>
</html>
