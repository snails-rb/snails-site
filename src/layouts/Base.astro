---
import '@fontsource-variable/jetbrains-mono';
import '../styles/site.css';
import '../styles/site-header.css';
import { firstChapterUrl } from '../lib/manual.mjs';
import { absoluteUrl } from '../lib/site.mjs';

// The header is on every page; the chapter sidebar belongs to the manual only.
// A page that wants the sidebar passes the chapter list it should show. The
// landing page asks for the wider shell so the hero can put code beside the
// claim; the manual and blog keep their reading column.
const {
  chapters = [],
  active = null,
  title = null,
  description = null,
  section = null,
  wide = false,
  article = false,
  canonical = Astro.url.pathname,
} = Astro.props;
const withSidebar = chapters.length > 0;
const pageTitle = title ? `${title} — Snails` : 'Snails — Ruby web apps, one native binary';
const pageDescription =
  description ??
  'Snails is a Rails-like framework for API-only Ruby apps. It keeps the Rails conventions and removes the layers that add runtime overhead.';
const canonicalUrl = absoluteUrl(canonical);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- The brand favicon set is transparent ink, which disappears on a dark
         browser tab. The site uses the same marks on a rounded paper tile
         instead. -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon-180.png" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Snails Blog"
      href={absoluteUrl('/blog/rss.xml')}
    />
    <meta property="og:site_name" content="Snails" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href="/">
          <!-- The site is dark-only, so the header uses the white lockup;
               the ink lockup is for light backgrounds. -->
          <img src="/brand/lockup-horizontal-white.svg" alt="Snails" width="71" height="16" />
        </a>
        <nav class="site-nav">
          <a class={section === 'manual' ? 'active' : ''} href={firstChapterUrl()}>Manual</a>
          <a class={section === 'blog' ? 'active' : ''} href="/blog/">Blog</a>
          <a class={section === 'api' ? 'active' : ''} href="/api/">API</a>
        </nav>
      </div>
    </header>

    <div class={withSidebar ? 'page with-sidebar' : wide ? 'page wide' : 'page'}>
      {
        withSidebar && (
          <nav class="sidebar">
            <ul>
              {chapters.map((chapter) => (
                <li class={chapter.slug === active ? 'active' : ''}>
                  <a href={`/manual/${chapter.slug}/`}>
                    <span class="num">{chapter.number}</span>
                    {chapter.title}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
