---
import '@fontsource-variable/jetbrains-mono';
import '../styles/site.css';
import '../styles/site-header.css';
import { url } from '../lib/manual.mjs';

// The header is on every page; the chapter sidebar belongs to the manual only.
// A page that wants the sidebar passes the chapter list it should show.
const { chapters = [], active = null, title = null, section = null } = Astro.props;
const withSidebar = chapters.length > 0;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} — Snails` : 'Snails — web apps that compile to a native binary'}</title>
    <meta
      name="description"
      content="Snails is a framework for building web apps that compile to a single native binary. You write ordinary Ruby; Snails turns it into one binary."
    />
  </head>
  <body>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href={url('/')}>Snails</a>
        <nav class="site-nav">
          <a class={section === 'manual' ? 'active' : ''} href={url('/manual/')}>Manual</a>
          <a class={section === 'api' ? 'active' : ''} href={url('/api/')}>API</a>
        </nav>
      </div>
    </header>

    <div class={withSidebar ? 'page with-sidebar' : 'page'}>
      {
        withSidebar && (
          <nav class="sidebar">
            <ul>
              {chapters.map((chapter) => (
                <li class={chapter.slug === active ? 'active' : ''}>
                  <a href={url(`/manual/${chapter.slug}/`)}>
                    <span class="num">{chapter.number}</span>
                    {chapter.title}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
      <main>
        <slot />
      </main>
    </div>
  </body>
</html>
