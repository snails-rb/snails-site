---
import Base from '../layouts/Base.astro';
import { firstChapterUrl } from '../lib/manual.mjs';
import { highlightCode } from '../lib/highlight.mjs';
import { performanceFigures } from '../lib/performance.mjs';

const routeCode = [
  '# inside Snails::RouteTable.table',
  'resources("/posts", PostsController, :json)',
].join('\n');

const controllerCode = [
  'class PostsController < ActionController::API',
  '  def index',
  '    render(json: posts)',
  '  end',
  '',
  '  private',
  '',
  '  def posts',
  '    Post.all.map { |post| post_json(post) }',
  '  end',
  '',
  '  def post_json(post)',
  '    { "id" => post.id, "title" => post.title }',
  '  end',
  'end',
].join('\n');

// Break opportunities inside the install URL keep the command readable on a
// phone without changing what the copy button hands over: <wbr> carries no
// text, so textContent is still the one-line command.
const installCommandHtml =
  'curl -fsSL <wbr/>https://<wbr/>raw.githubusercontent.com/<wbr/>snails-rb/<wbr/>snails/<wbr/>main/<wbr/>install.sh <wbr/>| bash';

const figures = performanceFigures();
const fastest = Math.max(...figures.series.map((target) => target.requests));
const latency = figures.rowValues('Response time, 95th percentile');
const memory = figures.rowValues('Memory under load');
const boot = figures.rowValues('Launch to first answer');
---
<Base wide>
  <article class="front">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status">1.0 RC</span> Ruby · native binary</p>
        <h1 id="hero-title">Ruby web apps.<br />One native binary.</h1>
        <p class="lede">
          Snails is a Rails-like framework that compiles API-only Ruby apps into one native
          binary. No Ruby runtime, no GVL, no Puma workers: one process serves requests on every
          core and boots in single-digit milliseconds. On our GET /up benchmark, that's about 3×
          the throughput of Rails in cluster mode with roughly 10× or more peak-memory savings — and
          ~12× against a default Rails app. A separate single-row DB read measures about 3.1×.
        </p>

        <div class="hero-actions">
          <a class="button primary" href="/manual/getting-started/">Get started</a>
          <a class="button quiet" href="https://github.com/snails-rb/snails">GitHub ↗</a>
        </div>

        <div class="install-bar">
          <div class="install-bar-head">
            <span>Install the CLI</span>
            <span>Linux · macOS for development</span>
          </div>
          <div class="install-bar-body" data-copy-source>
            <code set:html={installCommandHtml} />
            <button type="button" class="copy" data-copy hidden>Copy</button>
          </div>
        </div>

        <p class="hero-note">
          After that, <code>snails new demo</code> creates a project. The installer needs
          <code>curl</code> and <code>tar</code>; the first <code>snails new</code> also needs
          <code>git</code>, <code>make</code>, and a C compiler with the usual development
          headers. <a href="/manual/getting-started/#requirements">Full install guide →</a>
        </p>
        <p class="hero-status">1.0 release candidate. The public API may still change before 1.0.</p>
      </div>

      <div class="hero-demo" role="group" aria-label="A Snails route, controller, and test run">
        <div class="demo-head">
          <span class="demo-file">config/routes.rb</span>
          <span class="demo-lang">Ruby</span>
        </div>
        <div class="demo-code" set:html={highlightCode(routeCode, 'ruby')} />
        <div class="demo-head">
          <span class="demo-file">app/controllers/posts_controller.rb</span>
        </div>
        <div class="demo-code" set:html={highlightCode(controllerCode, 'ruby')} />
        <div class="demo-term" role="group" aria-label="Test output">
          <div><span class="demo-prompt">$</span> bin/test</div>
          <div><span class="demo-ok">ok</span> posts_test.rb</div>
          <div><span class="demo-ok">5/5 passed</span></div>
        </div>
      </div>
    </section>

    <section class="features" aria-labelledby="features-title">
      <p class="eyebrow">Why Snails</p>
      <h2 id="features-title">Rails conventions, one binary.</h2>
      <p class="section-lede">
        Snails keeps the Rails conventions an API needs. The view layer is gone, and the server
        runs without Ruby.
      </p>

      <div class="feature-grid">
        <a class="feature" href="/manual/coming-from-rails/">
          <h3 class="feature-title">The Rails shape</h3>
          <span class="feature-body">
            Routes, controllers, migrations, forms, mail, and jobs keep the shape you know.
            Models are plain classes over your tables, so the SQL stays visible.
          </span>
          <span class="feature-go">Coming from Rails →</span>
        </a>
        <a class="feature" href="/manual/deploying/">
          <h3 class="feature-title">One native binary</h3>
          <span class="feature-body">
            Your app, the framework, and the HTTP server compile into one file. The server needs
            no Ruby runtime — ship the binary or the container image.
          </span>
          <span class="feature-go">Deploying →</span>
        </a>
        <a class="feature" href="/manual/welcome-to-snails/#how-it-compares">
          <h3 class="feature-title">Every core, one process</h3>
          <span class="feature-body">
            Native code has no GVL, so a single process serves requests on all available cores.
            Memory does not multiply with worker count.
          </span>
          <span class="feature-go">How it compares →</span>
        </a>
        <a class="feature" href="/manual/testing/">
          <h3 class="feature-title">Tests against a real server</h3>
          <span class="feature-body">
            <code>bin/test</code> builds the app, boots it on a spare port, and sends real HTTP
            requests. Nothing mocks the framework out of the way.
          </span>
          <span class="feature-go">Testing →</span>
        </a>
      </div>

      <p class="scope">
        API-only by design: no HTML views, asset pipeline, or CSRF tokens. If you need
        server-rendered pages, this is the wrong tool.
      </p>
    </section>

    <section class="perf" aria-labelledby="performance">
      <h2 class="perf-title" id="performance">Performance</h2>

      <p class="perf-lede">
        Snails delivers about <strong>{figures.clusterRatio}×</strong> the throughput of Rails in
        cluster mode and <strong>{figures.defaultsRatio}×</strong> that of a default Rails app — the
        same <code>GET /up</code> on the same 8-core machine. It compiles to native code without
        Ruby's GVL, so one process uses every core; Rails needs a worker process per core to use the
        same hardware.
      </p>

      <figure class="perf-chart">
        <figcaption>Requests per second · 32 concurrent connections · higher is better</figcaption>
        <ul>
          {
            figures.series.map((target) => (
              <li class:list={['perf-row', { 'is-fastest': target.requests === fastest }]}>
                <span class="perf-row-head">
                  <span class="perf-row-label">{target.label}</span>
                  <span class="perf-row-value">{target.requests.toLocaleString('en-US')}</span>
                </span>
                <span class="perf-row-bar" aria-hidden="true">
                  <span
                    class="perf-row-fill"
                    style={`width: ${Math.round((target.requests / fastest) * 100)}%`}
                  />
                </span>
              </li>
            ))
          }
        </ul>
      </figure>

      <dl class="perf-stats">
        <div class="perf-stat">
          <dt>p95 latency</dt>
          <dd>
            <span class="perf-number">{latency[0]}</span>
            <span class="perf-note">Rails (cluster mode) {latency[1]}</span>
          </dd>
        </div>
        <div class="perf-stat">
          <dt>Startup time</dt>
          <dd>
            <span class="perf-number">{boot[0]}</span>
            <span class="perf-note">Rails (default) {boot[2]}</span>
          </dd>
        </div>
        <div class="perf-stat">
          <dt>Memory under load</dt>
          <dd>
            <span class="perf-number">{memory[0]}</span>
            <span class="perf-note">Rails (cluster mode) {memory[1]}</span>
          </dd>
        </div>
      </dl>

      <p class="perf-method">
        Medians of three 15-second runs with request logging off; startup time from five runs. The
        route serves JSON and touches no database or view, so this measures the request path. Ratios
        transfer between machines; absolute figures belong to the machine that ran them. See{' '}
        <a href="/manual/welcome-to-snails/#how-it-compares">How it compares</a> in the manual
        for the full table, and <a href="https://github.com/snails-rb/snails-benchmark">snails-benchmark</a>
        for the method and raw results.
      </p>
    </section>

    <div class="cards">
      <a class="card" href={firstChapterUrl()}>
        <span class="card-title">Manual</span>
        <span class="card-body">The full guide, from install to deploy.</span>
        <span class="card-go">Read the manual →</span>
      </a>
      <a class="card" href="/api/">
        <span class="card-title">API reference</span>
        <span class="card-body">The runtime's public surface, generated from its comments.</span>
        <span class="card-go">Browse the API →</span>
      </a>
      <a class="card" href="https://github.com/snails-rb/snails">
        <span class="card-title">Source</span>
        <span class="card-body">The framework and manual source, MIT licensed.</span>
        <span class="card-go">GitHub ↗</span>
      </a>
    </div>
  </article>

  <script>
    const button = document.querySelector('[data-copy]');
    const source = document.querySelector('[data-copy-source] code');
    if (button && source && navigator.clipboard) {
      button.hidden = false;
      button.addEventListener('click', async () => {
        await navigator.clipboard.writeText(source.textContent);
        button.textContent = 'Copied';
        setTimeout(() => { button.textContent = 'Copy'; }, 1500);
      });
    }
  </script>
</Base>
