---
import Base from '../layouts/Base.astro';
import { firstChapterUrl } from '../lib/manual.mjs';
import { highlightCode } from '../lib/highlight.mjs';

const routeCode = [
  '# inside Snails::RouteTable.table',
  'resources("/posts", PostsController, :json)',
].join('\n');

const controllerCode = [
  'class PostsController < ActionController::API',
  '  def index',
  '    render(json: posts)',
  '  end',
  '',
  '  private',
  '',
  '  def posts',
  '    Post.all.map { |post| post_json(post) }',
  '  end',
  '',
  '  def post_json(post)',
  '    { "id" => post.id, "title" => post.title }',
  '  end',
  'end',
].join('\n');

// Break opportunities inside the install URL keep the command readable on a
// phone without changing what the copy button hands over: <wbr> carries no
// text, so textContent is still the one-line command.
const installCommandHtml =
  'curl -fsSL <wbr/>https://<wbr/>raw.githubusercontent.com/<wbr/>snails-rb/<wbr/>snails/<wbr/>main/<wbr/>install.sh <wbr/>| bash';

// The landing figures are maintained here by hand. Update them with the
// benchmark results when the numbers change; the manual's Performance chapter
// and snails-benchmark carry the full record and method.
const figures = {
  series: [
    { label: 'Snails', requests: 50865 },
    { label: 'Rails (cluster mode)', requests: 16209 },
    { label: 'Rails (default)', requests: 4262 },
  ],
};
const fastest = Math.max(...figures.series.map((target) => target.requests));
const clusterRatio = String(Math.round(figures.series[0].requests / figures.series[1].requests));
const defaultsRatio = (figures.series[0].requests / figures.series[2].requests).toFixed(1);
const latency = { snails: '1.3 ms', railsCluster: '4.7 ms' };
const memory = { snails: '30 MiB', railsCluster: '701 MiB' };
const startup = { snails: '9 ms', railsDefault: '1.0 s' };
---
<Base wide>
  <article class="front">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status">1.x</span> API-only Ruby apps</p>
        <h1 id="hero-title">Rails conventions,<br />native performance.</h1>
        <p class="lede">
          Snails is a Rails-like framework for API-only Ruby apps. It keeps the Rails conventions,
          drops the Ruby runtime, and compiles the app into one native binary. One process uses
          every core, with about 3× the throughput and 10× lower peak memory under load than
          Rails in cluster mode.
        </p>

        <div class="hero-actions">
          <a class="button primary" href="/manual/getting-started/">Get started</a>
          <a class="button quiet" href="https://github.com/snails-rb/snails">GitHub ↗</a>
        </div>

        <div class="install-bar">
          <div class="install-bar-head">
            <span>Install the CLI</span>
            <span>Linux · macOS · WSL for development</span>
          </div>
          <div class="install-bar-body" data-copy-source>
            <code set:html={installCommandHtml} />
            <button type="button" class="copy" data-copy hidden>Copy</button>
          </div>
        </div>

        <p class="hero-note">
          After that, <code>snails new demo</code> creates a project and downloads the pinned
          compiler. The installer needs <code>curl</code> and <code>tar</code>; the first
          <code>bin/dev</code> or <code>bin/test</code> compiles the app and needs the development
          packages in the install guide. <a href="/manual/getting-started/#requirements">Full install guide →</a>
        </p>
        <p class="hero-status">1.x. The public API is stable.</p>
      </div>

      <div class="hero-demo" role="group" aria-label="A Snails route, controller, and test run">
        <div class="demo-head">
          <span class="demo-file">config/routes.rb</span>
          <span class="demo-lang">Ruby</span>
        </div>
        <div class="demo-code" set:html={highlightCode(routeCode, 'ruby')} />
        <div class="demo-head">
          <span class="demo-file">app/controllers/posts_controller.rb</span>
        </div>
        <div class="demo-code" set:html={highlightCode(controllerCode, 'ruby')} />
        <div class="demo-term" role="group" aria-label="Test output">
          <div><span class="demo-prompt">$</span> bin/test</div>
          <div><span class="demo-ok">ok</span> posts_test.rb</div>
          <div><span class="demo-ok">5/5 passed</span></div>
        </div>
      </div>
    </section>

    <section class="features" aria-labelledby="features-title">
      <p class="eyebrow">Design</p>
      <h2 id="features-title">The framework</h2>
      <p class="section-lede">
        Snails keeps the Rails conventions an API needs and removes the layers that add runtime
        overhead: the view layer, Active Record, and gem compatibility. The server runs without Ruby.
      </p>

      <div class="feature-grid">
        <a class="feature" href="/manual/coming-from-rails/">
          <h3 class="feature-title">The Rails conventions</h3>
          <span class="feature-body">
            Routes, controllers, migrations, forms, mailers, and jobs follow the Rails layout, so
            each endpoint has one clear place. Models are plain classes over your tables, with
            generated column readers and readable SQL.
          </span>
          <span class="feature-go">Coming from Rails →</span>
        </a>
        <a class="feature" href="/manual/deploying/">
          <h3 class="feature-title">One native binary</h3>
          <span class="feature-body">
            The app, the framework, and the HTTP server compile into one binary, while the code
            stays Ruby. Ship the file or a container image; there is no Ruby runtime, no Bundler,
            and no gem dependencies to install.
          </span>
          <span class="feature-go">Deploying →</span>
        </a>
        <a class="feature" href="/manual/performance/">
          <h3 class="feature-title">Every core, one process</h3>
          <span class="feature-body">
            Native code has no GVL; one process serves requests across every core. In cluster mode,
            Rails runs a separate worker process for each CPU core, and each worker carries its own
            VM, connection pool, and heap memory.
          </span>
          <span class="feature-go">Performance →</span>
        </a>
        <a class="feature" href="/manual/testing/">
          <h3 class="feature-title">Tests against a real server</h3>
          <span class="feature-body">
            <code>bin/test</code> builds the app, boots it on a spare port, and sends real HTTP
            requests. One fresh server serves the suite; each case resets the tables it declares,
            and the suite never mocks any part of the framework.
          </span>
          <span class="feature-go">Testing →</span>
        </a>
      </div>

      <p class="scope">
        API-only by design: no view layer or asset pipeline, no Active Record, no gem
        compatibility. If you need server-rendered pages or the full Rails stack, Rails is the
        better fit.
      </p>
    </section>

    <section class="perf" aria-labelledby="performance">
      <h2 class="perf-title" id="performance">Performance</h2>

      <p class="perf-lede">
        Snails delivers about <strong>{clusterRatio}×</strong> the throughput of Rails in
        cluster mode and <strong>{defaultsRatio}×</strong> that of a default Rails app — the
        same benchmark on the same 8-core machine. It compiles to native code without
        Ruby's GVL; one process uses every core, while Rails adds worker processes to use more cores.
      </p>

      <p class="perf-production">
        In production, one Rails API app{' '}
        <a href="/blog/a-native-rails-like-ruby-app-using-20-mb-of-memory/">ported to Snails</a>{' '}
        runs on a 1 GB node.
      </p>

      <figure class="perf-chart">
        <figcaption>Requests per second · 32 concurrent connections · higher is better</figcaption>
        <ul>
          {
            figures.series.map((target) => (
              <li class:list={['perf-row', { 'is-fastest': target.requests === fastest }]}>
                <span class="perf-row-head">
                  <span class="perf-row-label">{target.label}</span>
                  <span class="perf-row-value">{target.requests.toLocaleString('en-US')}</span>
                </span>
                <span class="perf-row-bar" aria-hidden="true">
                  <span
                    class="perf-row-fill"
                    style={`width: ${Math.round((target.requests / fastest) * 100)}%`}
                  />
                </span>
              </li>
            ))
          }
        </ul>
      </figure>

      <dl class="perf-stats">
        <div class="perf-stat">
          <dt>p95 latency</dt>
          <dd>
            <span class="perf-number">{latency.snails}</span>
            <span class="perf-note">Rails (cluster mode) {latency.railsCluster}</span>
          </dd>
        </div>
        <div class="perf-stat">
          <dt>Startup time</dt>
          <dd>
            <span class="perf-number">{startup.snails}</span>
            <span class="perf-note">Rails (default) {startup.railsDefault}</span>
          </dd>
        </div>
        <div class="perf-stat">
          <dt>Memory under load</dt>
          <dd>
            <span class="perf-number">{memory.snails}</span>
            <span class="perf-note">Rails (cluster mode) {memory.railsCluster}</span>
          </dd>
        </div>
      </dl>

      <p class="perf-method">
        Medians of three 15-second runs with request logging off; startup time from five runs. The
        route serves JSON and touches no database or view; this measures the request path. Ratios
        transfer between machines; absolute figures belong to the machine that ran them. See{' '}
        <a href="/manual/performance/">Performance</a> in the manual
        for the full table, and <a href="https://github.com/snails-rb/snails-benchmark">snails-benchmark</a> for
        the method and raw results.
      </p>
    </section>

    <div class="cards">
      <a class="card" href={firstChapterUrl()}>
        <span class="card-title">Manual</span>
        <span class="card-body">The full guide, from install to first deploy.</span>
        <span class="card-go">Read the manual →</span>
      </a>
      <a class="card" href="/api/">
        <span class="card-title">API Documentation</span>
        <span class="card-body">The framework's public classes and methods.</span>
        <span class="card-go">Browse the API →</span>
      </a>
      <a class="card" href="/blog/">
        <span class="card-title">Blog</span>
        <span class="card-body">Design notes, benchmarks, and release posts.</span>
        <span class="card-go">Read the blog →</span>
      </a>
      <a class="card" href="https://github.com/snails-rb/snails">
        <span class="card-title">Source</span>
        <span class="card-body">The framework, CLI, and manual, MIT licensed.</span>
        <span class="card-go">GitHub ↗</span>
      </a>
    </div>
  </article>

  <script>
    const button = document.querySelector('[data-copy]');
    const source = document.querySelector('[data-copy-source] code');
    if (button && source && navigator.clipboard) {
      button.hidden = false;
      button.addEventListener('click', async () => {
        await navigator.clipboard.writeText(source.textContent);
        button.textContent = 'Copied';
        setTimeout(() => { button.textContent = 'Copy'; }, 1500);
      });
    }
  </script>
</Base>
