---
import Base from '../layouts/Base.astro';
import { url } from '../lib/manual.mjs';
import { highlightCode } from '../lib/highlight.mjs';
import { performanceFigures } from '../lib/performance.mjs';

const installCommands = [
  '# install the CLI',
  'curl -fsSL https://raw.githubusercontent.com/snails-rb/dist/main/install.sh | bash',
  '',
  '# create a project',
  'snails new demo',
  '',
  '# build it and run its tests',
  'demo/bin/test',
].join('\n');

const figures = performanceFigures();
const fastest = Math.max(...figures.series.map((target) => target.requests));
const latency = figures.rowValues('Response time, 95th percentile');
const memory = figures.rowValues('Memory under load');
const boot = figures.rowValues('Launch to first answer');
---
<Base>
  <article class="front">
    <p class="eyebrow">Ruby → one native binary</p>
    <h1>Web apps that compile to one native binary</h1>
    <p class="lede">
      Snails is a framework for building web apps in ordinary Ruby. Routes, controllers, models,
      forms — Snails compiles them into a single binary that boots fast and runs anywhere a binary
      runs. No runtime to install on the server, no asset pipeline, no view layer: your app answers
      with JSON.
    </p>

    <section class="install">
      <div class="install-head">
        <h2 class="install-label">Install</h2>
        <span class="install-platform">Linux · macOS for development</span>
      </div>

      <p class="install-intro">
        The installer needs only <code>curl</code> and <code>tar</code>. From there, <code>snails new</code> creates a project and <code>bin/test</code> compiles it into one native binary and runs it against a real HTTP server — no container in the loop. The first build also needs <code>git</code>, <code>make</code>, and a C compiler with the usual development headers.
      </p>

      <div class="install-code" data-copy-source set:html={highlightCode(installCommands, 'sh')} />

      <div class="install-foot">
        <a href={url('/manual/getting-started/')}>Full install guide →</a>
        <button type="button" class="copy" data-copy hidden>Copy all</button>
      </div>
    </section>

    <p class="note">Status: alpha. The public API can change between 0.x releases.</p>

    <section class="perf" aria-labelledby="performance">
      <h2 class="perf-title" id="performance">Performance</h2>

      <p class="perf-lede">
        Snails delivers <strong>{figures.clusterRatio}×</strong> the throughput of Rails in cluster
        mode and <strong>{figures.defaultsRatio}×</strong> that of a default Rails app — the same
        <code>GET /up</code> on the same 8-core machine. It compiles to native code without Ruby's
        GVL, so one process uses every core; Rails needs a worker process per core to use the same
        hardware.
      </p>

      <figure class="perf-chart">
        <figcaption>Requests per second · 32 concurrent connections · higher is better</figcaption>
        <ul>
          {
            figures.series.map((target) => (
              <li class:list={['perf-row', { 'is-fastest': target.requests === fastest }]}>
                <span class="perf-row-head">
                  <span class="perf-row-label">{target.label}</span>
                  <span class="perf-row-value">{target.requests.toLocaleString('en-US')}</span>
                </span>
                <span class="perf-row-bar" aria-hidden="true">
                  <span
                    class="perf-row-fill"
                    style={`width: ${Math.round((target.requests / fastest) * 100)}%`}
                  />
                </span>
              </li>
            ))
          }
        </ul>
      </figure>

      <dl class="perf-stats">
        <div class="perf-stat">
          <dt>p95 latency</dt>
          <dd>
            <span class="perf-number">{latency[0]}</span>
            <span class="perf-note">Rails (cluster mode) {latency[1]}</span>
          </dd>
        </div>
        <div class="perf-stat">
          <dt>Startup time</dt>
          <dd>
            <span class="perf-number">{boot[0]}</span>
            <span class="perf-note">Rails (default) {boot[2]}</span>
          </dd>
        </div>
        <div class="perf-stat">
          <dt>Memory under load</dt>
          <dd>
            <span class="perf-number">{memory[0]}</span>
            <span class="perf-note">Rails (cluster mode) {memory[1]}</span>
          </dd>
        </div>
      </dl>

      <p class="perf-method">
        Medians of three 15-second runs with request logging off; startup time from five runs. The
        route serves JSON and touches no database or view, so this measures the request path. Ratios
        transfer between machines; absolute figures belong to the machine that ran them. See{' '}
        <a href={url('/manual/welcome-to-snails/#how-it-compares')}>How it compares</a> in the manual
        for the full table, and <a href="https://github.com/snails-rb/snails-benchmark">snails-benchmark</a>
        for the method and raw results.
      </p>
    </section>

    <div class="cards">
      <a class="card" href={url('/manual/')}>
        <span class="card-title">Manual</span>
        <span class="card-body">Everything you need to build, run, and ship an app. Eighteen chapters, from install to deploy.</span>
        <span class="card-go">Read the manual →</span>
      </a>
      <a class="card" href={url('/api/')}>
        <span class="card-title">API reference</span>
        <span class="card-body">The public surface of the runtime, generated from its comments.</span>
        <span class="card-go">Browse the API →</span>
      </a>
    </div>
  </article>

  <script>
    const button = document.querySelector('[data-copy]');
    const source = document.querySelector('[data-copy-source] code');
    if (button && source && navigator.clipboard) {
      button.hidden = false;
      button.addEventListener('click', async () => {
        await navigator.clipboard.writeText(source.textContent);
        button.textContent = 'Copied';
        setTimeout(() => { button.textContent = 'Copy all'; }, 1500);
      });
    }
  </script>
</Base>
