---
import Base from '../layouts/Base.astro';
import { url } from '../lib/manual.mjs';
import { highlightCode } from '../lib/highlight.mjs';
import { performanceFigures } from '../lib/performance.mjs';

const installCommands = [
  '# install the CLI',
  'curl -fsSL https://raw.githubusercontent.com/snails-rb/dist/main/install.sh | bash',
  '',
  '# create a project',
  'snails new demo',
  '',
  '# build it and run its tests',
  'demo/bin/test',
].join('\n');

const figures = performanceFigures();
const busiest = Math.max(...figures.rows.map((row) => row.requests));
---
<Base>
  <article class="front">
    <p class="eyebrow">Ruby → one native binary</p>
    <h1>Web apps that compile to one native binary</h1>
    <p class="lede">
      Snails is a framework for building web apps in ordinary Ruby. Routes, controllers, models,
      forms — Snails compiles them into a single binary that boots fast and runs anywhere a binary
      runs. No runtime to install on the server, no asset pipeline, no view layer: your app answers
      with JSON.
    </p>

    <section class="install">
      <div class="section-head">
        <h2 class="section-label">Install</h2>
        <span class="section-meta">Linux · macOS for development</span>
      </div>

      <p class="install-intro">
        The installer needs only <code>curl</code> and <code>tar</code>. From there, <code>snails new</code> creates a project and <code>bin/test</code> compiles it into one native binary and runs it against a real HTTP server — no container in the loop. The first build also needs <code>git</code>, <code>make</code>, and a C compiler with the usual development headers.
      </p>

      <div class="install-code" data-copy-source set:html={highlightCode(installCommands, 'sh')} />

      <div class="install-foot">
        <a href={url('/manual/getting-started/')}>Full install guide →</a>
        <button type="button" class="copy" data-copy hidden>Copy all</button>
      </div>
    </section>

    <p class="note">Status: alpha. The public API can change between 0.x releases.</p>

    <section class="perf" aria-labelledby="performance">
      <div class="section-head">
        <h2 class="section-label" id="performance">Performance</h2>
        <span class="section-meta">8 cores · framework defaults</span>
      </div>

      <p class="perf-lead">{figures.clusterRatio}× the requests of Rails Cluster Mode, {figures.railsRatio}× stock Rails.</p>

      <p class="perf-intro">
        Snails compiles to native code, so one process runs request handlers on every core the machine gives it. Rails uses more than one core only by running a worker process per core — cluster mode — and each worker keeps its own copy of the application in memory. Both run at framework defaults and answer the same <code>GET /up</code> with the same JSON body.
      </p>

      <figure class="chart">
        <figcaption class="chart-title">
          Requests per second <span class="chart-aside">higher is better</span>
        </figcaption>
        <ul class="bars">
          {
            figures.rows.map((row) => (
              <li class:list={['bar-row', { 'is-highest': row.requests === busiest }]}>
                <span class="bar-name">{row.name}</span>
                <span class="bar-track" aria-hidden="true">
                  <span class="bar-fill" style={`width: ${Math.round((row.requests / busiest) * 100)}%`} />
                </span>
                <span class="bar-value">{row.requests.toLocaleString('en-US')}</span>
              </li>
            ))
          }
        </ul>
      </figure>

      <dl class="perf-figures">
        <div class="perf-figure">
          <dt>Launch to first answer</dt>
          <dd><span class="perf-value">{figures.launch.snails}</span><span class="perf-compare">Rails: {figures.launch.rails}</span></dd>
        </div>
        <div class="perf-figure">
          <dt>Peak memory under load</dt>
          <dd><span class="perf-value">{figures.memory.snails}</span><span class="perf-compare">Rails Cluster Mode: {figures.memory.cluster}</span></dd>
        </div>
      </dl>

      <p class="perf-source">
        Medians of three 15-second runs at 32 concurrent connections on one 8-core machine, request logging off; launch time from five interleaved rounds. The route touches no database or view, so this compares the request path — absolute numbers belong to that hardware, and the ratios are what travel.
      </p>

      <div class="perf-foot">
        <a href={url('/manual/welcome-to-snails/#how-it-compares')}>Full comparison →</a>
        <a href="https://github.com/snails-rb/snails-benchmark">Method and raw results →</a>
      </div>
    </section>

    <div class="cards">
      <a class="card" href={url('/manual/')}>
        <span class="card-title">Manual</span>
        <span class="card-body">Everything you need to build, run, and ship an app. Eighteen chapters, from install to deploy.</span>
        <span class="card-go">Read the manual →</span>
      </a>
      <a class="card" href={url('/api/')}>
        <span class="card-title">API reference</span>
        <span class="card-body">The public surface of the runtime, generated from its comments.</span>
        <span class="card-go">Browse the API →</span>
      </a>
    </div>
  </article>

  <script>
    const button = document.querySelector('[data-copy]');
    const source = document.querySelector('[data-copy-source] code');
    if (button && source && navigator.clipboard) {
      button.hidden = false;
      button.addEventListener('click', async () => {
        await navigator.clipboard.writeText(source.textContent);
        button.textContent = 'Copied';
        setTimeout(() => { button.textContent = 'Copy all'; }, 1500);
      });
    }
  </script>
</Base>
