}

.docstring table tr:nth-child(even),
#filecontents table tr:nth-child(even) {
  background: var(--bg);
}

.tags .tag_title,
.docstring .note.title {
  color: var(--fg);
}

.note {
  background: var(--bg-deep);
  border-color: var(--line);
  color: var(--fg);
}

.note.title {
  background: var(--surface);
}

/* YARD paints several note variants with its own light fills — grey for a void
   return, yellow for a todo, pink for deprecated. The theme's text colour stays
   near-white, so those fills make the text vanish. Each variant gets a dark
   surface instead, and the chip variants get the accent tint. */
.note.returns_void,
.note.todo,
.note.private,
.note.deprecated {
  background: var(--bg-deep);
  border-color: var(--line);
  color: var(--muted);
}

.note.title.readonly,
.note.title.writeonly,
.note.title.constructor {
  background: var(--accent-soft);
  border-color: var(--accent);
  color: var(--accent-strong);
}

.note.title.private {
  background: var(--surface);
  border-color: var(--line);
  color: var(--muted);
}

#toc {
  background: var(--surface);
  border-color: var(--line);
  box-shadow: none;
}

/* Navigation frame */
.nav_wrap {
  background: var(--bg);
}

/* The nav is a fixed 20rem column, so YARD's resize handle has nothing to
   resize; it also sits 5px into the main column and covers the first
   character now that #main starts at the divider. */
#resizer {
  display: none;
}

