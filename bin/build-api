/* The rules below are for the class-list document that loads inside the nav
   frame. They are scoped to `.api-list` because the outer page has its own
   `#search` element (the nav toggle) that must keep YARD's positioning.

   YARD fixes that header to the top and pushes the list down by a hardcoded
   margin (70px/80px), a pair sized for Lucida at 13px. Monospace is taller, so
   the two no longer line up and the search box sits on the first rows. Sticky
   keeps the header in flow: the list starts after it at every size, with no
   height to keep in sync. */
.api-list .fixed_header {
  position: sticky;
  top: 0;
  height: auto;
  padding-bottom: 0.4rem;
}

.api-list #full_list_header {
  font-size: var(--text-base);
  padding: var(--space-3) 0.625rem var(--space-1);
}

.api-list #full_list_nav {
  font-size: var(--text-2xs);
  padding-left: 0.625rem;
}

.api-list #full_list_nav span {
  margin-right: var(--space-2);
}

.api-list #search {
  position: static;
  padding: 0.4rem 0.625rem 0;
}

.api-list #search label {
  font-size: var(--text-2xs);
}

.api-list #search input {
  width: 100%;
  max-width: 12rem;
  margin-left: var(--space-1);
}

.api-list #full_list {
  margin-top: 0;
  font-size: var(--text-sm);
}

/* YARD sets `white-space: nowrap` for its proportional faces. A monospace class
   name such as `UnpermittedParameters < StandardError` overruns the 20rem nav
   and is cut off at the panel edge, so the rows wrap instead. */
.api-list #full_list li {
  white-space: normal;
}

.api-list #full_list li .item {
  padding: 0.3rem var(--space-2);
  line-height: var(--leading-heading);
}

#full_list li a {
  overflow-wrap: anywhere;
}

@media (max-width: 640px) {
  /* `Class: ActionController::API` is one unbreakable token: at 30px it is
     wider than a phone and breaks mid-identifier. The page title steps down to
     h2's size here instead, which keeps it on one line. */
  h1 {
    font-size: var(--text-xl);
  }

  /* YARD pins the section toggle to the right edge of the heading, where a
     20px monospace title runs underneath it. In flow it wraps to its own row;
     `fit-content` keeps the chip the size of its label instead of the column. */
  h2 small {
    position: static;
    display: block;
    margin-top: var(--space-1);
  }

  h2 small a {
    display: inline-block;
    width: fit-content;
  }
}

@media (max-width: 920px) {
  /* YARD turns the nav into an overlay at this width; the body must scroll the
     page instead of pinning it to the viewport, or the overlay is clipped. */
  body {
    height: auto;
    min-height: 100vh;
  }

  .yard-body {
    display: block;
    /* The header keeps its 1.25rem side padding here; the body has to start
       on the same line instead of touching the viewport edge. */
    padding: 0 var(--space-5);
  }

  /* The overlay would otherwise cover the shared header. */
  #nav {
    top: 3rem;
    background: var(--bg);
    border: 1px solid var(--line);
    box-shadow: none;
  }

  /* The nav toggle is positioned against the viewport origin in YARD's layout,
     which is now the shared header. Anchor it to the content box instead. */
  #search {
    top: 0.25rem;
  }
}
CSS

    cat <<CSS

@font-face {
  font-family: 'JetBrains Mono Variable';
  font-style: normal;
  font-weight: 100 800;
  font-display: swap;
  src: url(../fonts/jetbrains-mono-latin-wght-normal.woff2) format('woff2-variations');
}
CSS
  } > "$dest/css/site-chrome.css"

  cp "$ROOT/node_modules/@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2" "$dest/fonts/"
}

render() {
  local dest="$1"
  local db
  db="$(mktemp -d)"
  cleanup_dirs+=("$db")
  rm -rf "$dest"
  ( cd "$stage" && BUNDLE_GEMFILE="$ROOT/Gemfile" bundle exec yardoc \
      --output-dir "$dest" \
      --db "$db/yardoc" \
      --no-save \
      --no-private \
      --template-path "$ROOT/templates/yard" \
      --readme "api-index.md" \
      --exclude 'runtime/tep/' \
      --title 'Snails API' \
      "${rbs_files[@]}" "${rb_files[@]}" )
  copy_chrome "$dest"
}

render "$OUT"

if (( check )); then
  tmp="$(mktemp -d)"
  cleanup_dirs+=("$tmp")
  render "$tmp/api" >/dev/null
  if ! diff -rq "$OUT" "$tmp/api" >/dev/null; then
    echo "[build-api] API output is not reproducible — it differs from a second render:" >&2
    diff -rq "$OUT" "$tmp/api" >&2 | head -20
    exit 1
  fi
  echo "[build-api] reproducible (two renders identical)"
fi

echo "[build-api] public/api ready ($(find "$OUT" -name '*.html' | wc -l | tr -d ' ') pages)"
