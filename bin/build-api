#!/bin/bash
# Render the API reference into public/api/ from the runtime source.
#
#   bin/build-api [--check] [<snails checkout>]
#
# The input is the public repo's runtime/ tree, fetched into a scratch
# directory and thrown away afterwards. The site repo holds no copy of the
# source: one owner, no drift.
#
# The input order matters: YARD merges a signature from the first file that
# declares it, so `*.rbs` goes first. With `.rb` first, the type sidecar
# re-declares private helpers as public and they leak into the docs.
#
# `--check` renders twice and fails when the two differ — the docs must depend
# on the source alone, not on the clock.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT="$ROOT/public/api"
REPO="${SNAILS_REPO:-snails-rb/snails}"

check=0
if [[ ${1:-} == "--check" ]]; then
  check=1
  shift
fi

# A local checkout is the offline path used by a hand run and by the tests.
# Without one, fetch the public repo the way the refresh workflow does.
src_root=""
cleanup_dirs=()
trap 'rm -rf "${cleanup_dirs[@]}"' EXIT

if [[ -n ${1:-} ]]; then
  [[ -d $1/runtime ]] || { echo "[build-api] no runtime/ under $1" >&2; exit 1; }
  src_root="$1"
else
  scratch="$(mktemp -d)"
  cleanup_dirs+=("$scratch")
  git clone --quiet --depth 1 --filter=blob:none --sparse "https://github.com/$REPO" "$scratch/snails"
  git -C "$scratch/snails" sparse-checkout set --no-cone '/runtime/'
  src_root="$scratch/snails"
fi
echo "[build-api] source $src_root"

# YARD renders a README.md in the working directory as the index page, ignoring
# the `--readme` argument, so the render runs in a stage directory that holds
# only a copy of the source tree and the site's own index page. The copy keeps
# the input paths as `runtime/...`, which is what YARD turns into file pages.
stage="$(mktemp -d)"
cleanup_dirs+=("$stage")
cp -R "$src_root/runtime" "$stage/runtime"
cp "$ROOT/templates/yard/api-index.md" "$stage/api-index.md"

# Same default as astro.config.mjs: the site is served from the domain root.
# The YARD header and footer link back to the site, so they need the base.
export SITE_BASE="${SITE_BASE:-/}"

# The API header links to the manual entry, the first chapter, like every other
# page's header; there is no `/manual/` landing page to send visitors through.
# The glob order matches the chapter order loadChapters() uses.
first_chapter=""
for file in "$ROOT"/manual/[0-9][0-9]-*.md; do
  chapter="${file##*/}"
  [[ $chapter =~ ^[0-9][0-9]-[A-Za-z0-9_-]+\.md$ ]] || continue
  first_chapter=$chapter
  break
done
[[ -n $first_chapter ]] || { echo "[build-api] no manual chapter under $ROOT/manual" >&2; exit 1; }
export MANUAL_ENTRY_URL="${SITE_BASE%/}/manual/${first_chapter:3:-3}/"

rbs_files=()
while IFS= read -r file; do rbs_files+=("$file"); done < <(cd "$stage" && find runtime -name '*.rbs' | sort)

rb_files=()
while IFS= read -r file; do rb_files+=("$file"); done < <(cd "$stage" && find runtime -name '*.rb' | sort)

# The API pages share the site header and fonts, and nothing else. YARD owns
# the content styling on purpose: its default link colour (#05a on white) has
# 7.3:1 contrast, and the reference pages are dense with links and signatures
# where the site's softer palette measurably loses legibility.
copy_chrome() {
  local dest="$1"
  mkdir -p "$dest/css" "$dest/fonts"

  {
    echo "/* Generated by bin/build-api from src/styles/tokens.css and"
    echo "   src/styles/site-header.css — do not edit the copy in public/api. */"
    cat "$ROOT/src/styles/tokens.css"
    cat "$ROOT/src/styles/site-header.css"

    cat <<'CSS'

/* --- API surface --------------------------------------------------------
   The API pages carry the same Dracula palette as the rest of the site. YARD's
   own stylesheet hardcodes light greys, so the colours below are the one place
   they are re-pointed.

   Type sizes come from the site scale in tokens.css, one step down from the
   manual where YARD packs more onto the page. YARD's own scale (13px body,
   15px docstring) was tuned for a proportional face; JetBrains Mono is a
   monospace and each character is ~30% wider, so the same px sizes overflow —
   nav labels clip and code blocks force horizontal scroll. The steps below
   restore the *measured line width* YARD was designed for, not the nominal px
   value.

   Contrast follows the same rule as the site: the spec's comment colour
   (var(--syntax-comment)) is used for syntax only, never for text that must be read. */

/* YARD's own stylesheet sizes most of its content in `em` against this body
   size (menus, inheritance trees, the on-page table of contents). Those em
   chains were tuned for a 13px proportional body; 12px is the step that
   occupies the same measured width in a monospace face, and leaving it here
   keeps every YARD-internal ratio intact. Text the site actually writes
   (docstrings, summaries, code) is set explicitly below. */
body {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--bg);
  color: var(--fg);
  font-family: var(--font-body);
  font-size: var(--text-xs);
  line-height: var(--leading-prose);
}

.yard-body {
  display: flex;
  flex: 1;
  min-height: 0;
}

/* The shared header is 72rem. Center YARD's body on the same shell so the
   navigation starts where the brand does, instead of at the viewport edge.
   The side padding follows the header's own breakpoint: 1.25rem under 60rem,
   1.5rem above it. */
@media (min-width: 921px) {
  .yard-body {
    box-sizing: border-box;
    width: 100%;
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 var(--space-5);
  }
}

@media (min-width: 961px) {
  .yard-body {
    padding: 0 var(--space-6);
  }
}

/* The nav is a fixed column, not a percentage: monospace class names are wider
   than the proportional face YARD sized the 20% split for. */
.nav_wrap {
  width: 20rem;
  flex-shrink: 0;
}

@media (max-width: 920px) {
  .nav_wrap {
    width: auto;
  }
}

/* YARD sets 15px for prose; the site's 14px step is what a monospace face
   carries at the same measured width. */
.docstring,
.tags,
#filecontents {
  font-size: var(--text-md);
  line-height: var(--leading-prose);
}

.docstring h1 { font-size: var(--text-xl); }
.docstring h2 { font-size: var(--text-lg); }
.docstring h3,
.docstring h4 { font-size: var(--text-base); }

h1 {
  font-size: var(--text-2xl);
  line-height: var(--leading-tight);
  /* `Class: ActionController::API` is one unbreakable token wider than a phone.
     YARD's own headings never wrapped, so this only shows up at the narrow end. */
  overflow-wrap: anywhere;
}
h1.alphaindex { font-size: var(--text-xl); }
h2 { font-size: var(--text-xl); line-height: var(--leading-heading); }
h3.inherited { font-size: var(--text-md); }

/* Everything YARD renders in a monospace face — signatures, summaries, code —
   uses the site face so the page reads as one system. */
h3.signature,
p.signature,
h3.signature tt,
p.signature tt,
ul.summary,
ul.summary a,
#content code,
#content tt,
pre.code,
.tags pre.example,
.docstring pre.code,
#filecontents pre.code,
.source_code pre,
.docstring pre.code code,
.summary_desc .object_link a,
.docstring .object_link a {
  font-family: var(--font-mono);
}

ul.summary,
ul.summary a {
  font-size: var(--text-sm);
}

h3.signature,
p.signature {
  font-size: var(--text-sm);
}

pre.code,
.tags pre.example,
.docstring pre.code,
#filecontents pre.code {
  font-size: var(--text-xs);
  line-height: var(--leading-prose);
}

/* Links and headings */
a, #content a, #content a:visited, #menu a, #menu a:visited {
  color: var(--accent);
}

#content a:hover {
  color: var(--accent-strong);
  background: transparent;
}

#main {
  background: var(--bg);
  /* YARD insets #main by 1.2em. The nav ends at a border; 1rem is the content
     gap the rest of the site uses most often, and the resize handle is hidden
     so nothing overlays this gutter. */
  padding-left: var(--space-4);
}

h1, h2, h3, h4, h5, h6 {
  color: var(--fg);
}

h1 {
  border-top-color: var(--line);
}

h2 {
  border-bottom-color: var(--line);
}

/* Signatures and summaries */
h3.signature, p.signature {
  background: var(--bg-deep);
  border-color: var(--line);
  border-radius: var(--radius);
  color: var(--fg);
}

h3.signature a, p.signature a {
  color: var(--syntax-cyan);
}

.summary_signature {
  background: var(--surface);
  border-color: var(--line);
  border-radius: var(--radius);
}

.summary_signature:hover {
  background: var(--accent-soft);
  border-color: var(--accent);
}

.summary_signature a,
ul.summary a {
  color: var(--syntax-cyan);
}

/* Inline code and code blocks */
*:not(pre) > code,
.docstring p > code,
.docstring p > tt,
.tags p > code,
.tags p > tt {
  color: var(--syntax-orange);
  background: var(--bg-deep);
  border: 1px solid var(--line);
  border-radius: 4px;
}

pre.code,
.docstring pre.code,
#filecontents pre.code,
.tags pre.example {
  background: var(--bg-deep);
  border: 1px solid var(--line);
  border-left: 3px solid var(--accent);
  border-radius: var(--radius);
  color: var(--fg);
}

/* A constant's value is a bare <pre> inside its <dd>, outside `.docstring`, so
   YARD's padding rule (which only matches docstring and file examples) never
   reaches it: the value sat flush against the accent border, and as a block it
   drew an empty box the full 75% column width. Inline-block keeps the box the
   size of the value.

   `white-space: pre` on the `dd` means a long literal (the timezone table, the
   status-code map) cannot wrap, so it scrolls inside its own box instead of
   widening the whole page on a phone. */
dl.constants dd pre.code {
  display: inline-block;
  margin: 0;
  padding: var(--space-1) 0.625rem;
  max-width: 100%;
  overflow-x: auto;
}

/* YARD's tag lists (Yields:, Returns:, Parameters:) hold types in a `span.type`
   with `white-space: pre` on the enclosing `dd`-free list, so a long signature
   such as `(token, token_options(...))` stays on one line and runs off a phone.
   The tags are prose-like data, not code: they wrap. */
.tags ul,
.tags .type {
  white-space: normal;
  overflow-wrap: anywhere;
}

/* YARD's syntax classes, mapped to the role names in tokens.css — the same
   names the manual's highlighter emits, so a token has one colour across both
   sections and tokens.css stays the only place a colour is written. */
pre.code .comment { color: var(--syntax-comment); }
pre.code .const,
pre.code .constant {
  color: var(--syntax-purple);
}
pre.code .kw,
pre.code .rubyid_require,
pre.code .rubyid_extend,
pre.code .rubyid_include {
  color: var(--syntax-pink);
}
pre.code .tstring_content,
pre.code .heredoc_beg,
pre.code .heredoc_end,
pre.code .qwords_beg,
pre.code .qwords_end,
pre.code .qwords_sep,
pre.code .words_beg,
pre.code .words_end,
pre.code .words_sep,
pre.code .qsymbols_beg,
pre.code .qsymbols_end,
pre.code .qsymbols_sep,
pre.code .symbols_beg,
pre.code .symbols_end,
pre.code .symbols_sep,
pre.code .tstring,
pre.code .dstring,
pre.code .regexp,
pre.code .dregexp {
  color: var(--syntax-yellow);
}
pre.code .label,
pre.code .symbol {
  color: var(--syntax-pink);
}
pre.code .ivar,
pre.code .gvar,
pre.code .rubyid_backref,
pre.code .rubyid_nth_ref {
  color: var(--syntax-cyan);
}
pre.code .fid,
pre.code .rubyid_new,
pre.code .rubyid_to_s,
pre.code .rubyid_to_f,
pre.code .rubyid_to_i,
pre.code .rubyid_each,
pre.code .dot + pre.code .id {
  color: var(--syntax-green);
}
pre.code .val {
  color: var(--syntax-orange);
}
pre.code .info.file {
  color: var(--muted);
}
pre.code .lines {
  color: var(--muted);
}

/* Definition boxes, tags, tables */
.box_info dl dt,
.box_info dl dd {
  border-color: var(--line);
  background: var(--surface);
  color: var(--fg);
}

.box_info dl:nth-child(odd) > * {
