{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "snails-site",
  "compatibility_date": "2026-11-12",
  "preview_urls": true,
  // GitHub Actions builds dist/ and uploads it; Cloudflare serves the files and
  // never runs a second build. The www redirect is a Cloudflare Redirect Rule,
  // not Worker code.
  "assets": {
    "directory": "./dist",
    // Astro writes manual/<slug>/index.html while YARD writes <Class>.html.
    // `auto-trailing-slash` keeps both URL shapes working.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
}
